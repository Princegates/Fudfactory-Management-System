DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres"

# Secret used to sign staff & customer session JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-value"

# Optional: set to "true" on a deployment that should show only the public
# ordering site — hides the "Staff Login" links and makes /portal/* redirect
# home instead of loading the staff management portal.
NEXT_PUBLIC_HIDE_STAFF_PORTAL="false"
