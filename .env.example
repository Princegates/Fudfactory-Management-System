# From Supabase: Project -> Connect -> ORM -> Prisma
# Pooled connection (used by the running app)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true"
# Direct/session connection (used only for `prisma migrate`)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres"

# Secret used to sign staff & customer session JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-value"

# Your deployed site's own public URL — used for the sitemap, robots.txt
# and social-share metadata. Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL="https://yourbusiness.com"
